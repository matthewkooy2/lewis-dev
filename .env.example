DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CODE_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
LEWIS_DEBUG=false

# Optional. If omitted, Lewis defaults to "the user" and email drafts use
# neutral signoffs without a personal name.
LEWIS_USER_NAME=

LEWIS_MAX_TOOL_CALLS=5
LEWIS_MAX_DAILY_COST_USD=1.00

# Set these from DeepSeek's current pricing if you want cost estimates.
DEEPSEEK_PRICE_PER_1K_INPUT=0.0
DEEPSEEK_PRICE_PER_1K_OUTPUT=0.0

# Developer/code workspace tools (trace_symbol, list_project_files,
# read_project_file, search_project, and `python -m app.main trace`).
# LEWIS_DEVELOPER_CODE_WORKSPACE only gates whether the chat tools are
# registered; it does not choose which repository they analyze.
# LEWIS_DEVELOPER_WORKSPACE_ROOT selects that repository. Leave it unset to
# have developer code tools analyze Lewis itself. If set, it must be an
# existing directory or Lewis reports a clear error instead of silently
# falling back to its own repository.
LEWIS_DEVELOPER_CODE_WORKSPACE=false
LEWIS_DEVELOPER_WORKSPACE_ROOT=

# Freestyle model provider. "deepseek" (default) uses the DEEPSEEK_* values
# above. "local-openai" (aliases: local, lmstudio) uses one explicitly
# configured local OpenAI-compatible endpoint (LM Studio, llama.cpp, vLLM)
# on a loopback host. The local provider needs no real API key, is always
# local-only, and never falls back to a remote provider; if the endpoint is
# down, freestyle jobs fail closed with a recorded error.
LEWIS_FREESTYLE_PROVIDER=deepseek
LEWIS_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LEWIS_LOCAL_CODE_MODEL=qwen2.5-coder-7b-instruct
LEWIS_LOCAL_API_KEY=
# Send response_format={"type":"json_object"} to the local endpoint. Leave
# false unless the local server supports OpenAI JSON mode; structured output
# is deterministically validated either way.
LEWIS_LOCAL_JSON_MODE=false
# Refuse any remote provider (including DeepSeek) for freestyle generation.
LEWIS_FREESTYLE_LOCAL_ONLY=false
