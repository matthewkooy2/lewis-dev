DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CODE_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Broad developer/debug mode: prints a token-usage summary after each model
# request, and also enables the Freestyle web UI (see LEWIS_FREESTYLE_UI
# below for a narrower way to enable just that).
LEWIS_DEBUG=false
# Enables only the Freestyle web UI: the /dev/freestyle routes and its
# "Developer" dashboard navigation link. Prefer this over LEWIS_DEBUG when
# you only want Freestyle, since LEWIS_DEBUG also turns on unrelated debug
# output. Every job-creation, apply, checks, refine, cleanup, and recover
# action in the UI still requires its own explicit confirmation regardless
# of this flag; see LEWIS_FREESTYLE_PROVIDER below to choose which model
# backs Freestyle job generation.
LEWIS_FREESTYLE_UI=false

# Enables the developer-only Coding Agents UI at /dev/coding-agents. Phase 1
# launches bounded read-only analysis/proposal jobs through the locally
# authenticated Codex CLI or Claude Code CLI. Opening the page does not start
# any process; launching a job requires explicit confirmation.
LEWIS_CODING_AGENTS_UI=false
# Local allowlist of Git repository roots where Coding Agents may run. Use the
# OS path separator between entries (semicolon on Windows). Lewis does not
# auto-discover repositories and the browser never supplies paths.
LEWIS_CODING_AGENT_REPOSITORIES=
# Optional explicit executable locations. Leave empty to use safe PATH lookup.
# Do not put credentials here; Lewis uses the CLIs' existing authenticated
# local environment and never forwards browser-supplied environment variables.
LEWIS_CODEX_CLI_PATH=
LEWIS_CLAUDE_CLI_PATH=
# Server-side bounds for Coding Agents jobs. Per-job form values are clamped to
# these limits and cannot enable write-capable modes.
LEWIS_CODING_AGENT_DEFAULT_TIMEOUT_SECONDS=600
LEWIS_CODING_AGENT_MAX_TIMEOUT_SECONDS=3600

# Optional. If omitted, Lewis defaults to "the user" and email drafts use
# neutral signoffs without a personal name.
LEWIS_USER_NAME=

LEWIS_MAX_TOOL_CALLS=5
LEWIS_MAX_DAILY_COST_USD=1.00

# Set these from DeepSeek's current pricing if you want cost estimates.
DEEPSEEK_PRICE_PER_1K_INPUT=0.0
DEEPSEEK_PRICE_PER_1K_OUTPUT=0.0

# Developer/code workspace tools (trace_symbol, list_project_files,
# read_project_file, search_project, and `python -m app.main trace`).
# LEWIS_DEVELOPER_CODE_WORKSPACE only gates whether the chat tools are
# registered; it does not choose which repository they analyze.
# LEWIS_DEVELOPER_WORKSPACE_ROOT selects that repository. Leave it unset to
# have developer code tools analyze Lewis itself. If set, it must be an
# existing directory or Lewis reports a clear error instead of silently
# falling back to its own repository.
LEWIS_DEVELOPER_CODE_WORKSPACE=false
LEWIS_DEVELOPER_WORKSPACE_ROOT=

# Freestyle model provider. "deepseek" (default) uses the DEEPSEEK_* values
# above. "local-openai" (aliases: local, lmstudio) uses one explicitly
# configured local OpenAI-compatible endpoint (LM Studio, llama.cpp, vLLM)
# on a loopback host. The local provider needs no real API key, is always
# local-only, and never falls back to a remote provider; if the endpoint is
# down, freestyle jobs fail closed with a recorded error.
LEWIS_FREESTYLE_PROVIDER=deepseek
LEWIS_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LEWIS_LOCAL_CODE_MODEL=qwen2.5-coder-7b-instruct
LEWIS_LOCAL_API_KEY=
# Send response_format={"type":"json_schema", ...} to the local endpoint.
# Leave false for explicit text mode unless the local server supports JSON
# Schema structured output; Lewis deterministically validates either way.
LEWIS_LOCAL_JSON_MODE=false
# Optional deterministic sampling seed for the local endpoint (LM Studio,
# vLLM). Leave empty to omit the seed parameter entirely.
LEWIS_LOCAL_SEED=
# Refuse any remote provider (including DeepSeek) for freestyle generation.
LEWIS_FREESTYLE_LOCAL_ONLY=false
